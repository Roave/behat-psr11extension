{
    "name": "roave/behat-psr11extension",
    "description": "PSR-11 Container extension for Behat",
    "type": "library",
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "behat/behat": "^3.25.0",
        "psr/container": "^2.0.2",
        "symfony/config": "^7.3.4",
        "symfony/dependency-injection": "^6.4.26"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "laminas/laminas-servicemanager": "^4.4.0",
        "phpunit/phpunit": "^9.6.29"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "James Titcumb",
            "email": "james@asgrim.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Roave\\BehatPsrContainer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoaveFeatureTest\\BehatPsrContainer\\": "features/bootstrap/",
            "RoaveTest\\BehatPsrContainer\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.99"
        },
        "sort-packages": true
    }
}
